# Konfigurasi Supabase Client (Aman untuk Frontend / Vite)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Konfigurasi Supabase Server-Side (HANYA untuk Backend / Vercel Serverless Functions)
# JANGAN PERNAH memakai prefix VITE_ untuk Service Role Key!
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# URL Aplikasi (Opsional, diisi otomatis di production)
APP_URL="http://localhost:3000"
